[Unit]
Description=Jetson Orin HFT Layer 1 - Multi-Venue L2 OrderBook & NLP News Ingestion Daemon
After=network-online.target systemd-resolved.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/jetson-hft
Environment="PYTHONUNBUFFERED=1"
Environment="JETSON_CONFIG_PATH=/opt/jetson-hft/config/settings.yaml"
ExecStartPre=/opt/jetson-hft/deploy/scripts/setup_jetson_max_perf.sh
ExecStart=/usr/bin/numactl --cpunodebind=0 --membind=0 /usr/bin/taskset -c 0-3 /usr/bin/chrt -f 90 /usr/bin/python3 -m edge.ingestion.main
Restart=always
RestartSec=1
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=90
CPUAffinity=0 1 2 3
LimitMEMLOCK=infinity
LimitNOFILE=1048576
NoNewPrivileges=false
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
