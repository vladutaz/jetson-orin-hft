[Unit]
Description=Jetson Orin HFT Layer 5 - Encrypted Mobile Telemetry & Kill-Switch Gateway
After=network-online.target jetson-engine.service tailscaled.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/jetson-hft
Environment="PYTHONUNBUFFERED=1"
Environment="JETSON_CONFIG_PATH=/opt/jetson-hft/config/settings.yaml"
ExecStart=/usr/bin/taskset -c 8-9 /usr/bin/chrt -f 85 /usr/bin/python3 -m edge.gateway.server
Restart=always
RestartSec=1
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=85
CPUAffinity=8 9
LimitMEMLOCK=infinity
LimitNOFILE=524288
WatchdogSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
