[Unit]
Description=Jetson Orin HFT Layer 3 & 4 - TensorRT Alpha Prediction & Risk/Execution Engine
After=network-online.target jetson-ingest.service
Requires=jetson-ingest.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/jetson-hft
Environment="PYTHONUNBUFFERED=1"
Environment="CUDA_MODULE_LOADING=LAZY"
Environment="JETSON_CONFIG_PATH=/opt/jetson-hft/config/settings.yaml"
EnvironmentFile=-/opt/jetson-hft/config/secrets.env
ExecStart=/usr/bin/numactl --cpunodebind=0 --membind=0 /usr/bin/taskset -c 4-7 /usr/bin/chrt -f 99 /usr/bin/python3 -m edge.execution.main
Restart=always
RestartSec=1
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=99
CPUAffinity=4 5 6 7
LimitMEMLOCK=infinity
LimitNOFILE=1048576
OOMScoreAdjust=-900
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
